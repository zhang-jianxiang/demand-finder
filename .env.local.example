# ════════════════════════════════════════════
# Find Demands — 环境变量配置示例
# 复制为 .env.local 后填入真实值
# ════════════════════════════════════════════

# ─── 数据库 (Supabase PostgreSQL) ───
# Transaction pooler (应用运行时用, 支持 Serverless)
DATABASE_URL=postgresql://用户名:密码@aws-xx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (Prisma 迁移/建表用 — Session pooler 端口5432)
DIRECT_URL=postgresql://用户名:密码@aws-xx.pooler.supabase.com:5432/postgres

# ─── LLM 配置 (DeepSeek) ───
LLM_PROVIDER=deepseek
LLM_API_KEY=你的DeepSeek API Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ─── TikHub API (知乎/小红书/Reddit 数据采集) ───
TIKHUB_API_KEY=你的TikHub API Key
TIKHUB_BASE_URL=https://api.tikhub.dev

# ─── Reddit 生活/工作类 Subreddit ───
REDDIT_SUBREDDITS=LifeProTips,productivity,BuyItForLife,smallbusiness,Entrepreneur,finance,home,Parenting,Cooking,DIY

# ─── 知乎搜索关键词 ───
ZHIHU_KEYWORDS=有没有好用的,求推荐,太麻烦了,怎么办,有没有什么办法,吐槽,踩坑,后悔买,智商税,不值得

# ─── 小红书搜索关键词 ───
XHS_KEYWORDS=后悔买了,千万别买,求推荐好用的,有没有好用的,太难了怎么办,吐槽一下,踩坑分享,智商税,不值得买,有没有替代

# ─── 微博搜索关键词 ───
WEIBO_KEYWORDS=求助,推荐,吐槽,太难了,有没有,怎么办,买什么,哪个好

# ─── HackerNews (英文需求补充源) ───
HN_ALGOLIA_URL=https://hn.algolia.com/api/v1
HN_SEARCH_KEYWORDS=
HN_MAX_RESULTS=50

# ─── 通用 ───
LOG_LEVEL=INFO
