# ════════════════════════════════════════════
# Find Demands — 环境变量配置示例
# 复制为 .env.local 后填入真实值
# ════════════════════════════════════════════

# ─── 数据库 (Supabase PostgreSQL) ───
# Transaction pooler (应用运行时用, 支持 Serverless)
DATABASE_URL=postgresql://用户名:密码@aws-xx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (Prisma 迁移/建表用 — Session pooler 端口5432)
DIRECT_URL=postgresql://用户名:密码@aws-xx.pooler.supabase.com:5432/postgres

# ─── LLM 配置 (DeepSeek) ───
LLM_PROVIDER=deepseek
LLM_API_KEY=你的DeepSeek API Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ─── TikHub API (知乎/小红书/Reddit 数据采集) ───
TIKHUB_API_KEY=你的TikHub API Key
TIKHUB_BASE_URL=https://api.tikhub.dev

# ─── Reddit 软件/工具类 Subreddit ───
REDDIT_SUBREDDITS=selfhosted,software,apps,productivity,webdev,programming,freesoftware,opensource,macapps,androidapps

# ─── 知乎搜索关键词（聚焦软件/工具）───
ZHIHU_KEYWORDS=有没有好用的App,求推荐软件,有没有什么工具,免费替代,太贵了有没有替代,效率工具推荐,有没有开源的,好用的插件推荐

# ─── 小红书搜索关键词（聚焦软件/工具）───
XHS_KEYWORDS=好用的App推荐,效率工具分享,免费软件推荐,App避雷,软件踩坑,有没有好用的App,替代软件推荐,宝藏App,工具推荐,学生党App

# ─── 微博搜索关键词（聚焦软件/工具）───
WEIBO_KEYWORDS=App推荐,工具推荐,效率软件,免费工具,软件避雷,有没有好用的App

# ─── HackerNews (英文需求补充源) ───
HN_ALGOLIA_URL=https://hn.algolia.com/api/v1
HN_SEARCH_KEYWORDS=
HN_MAX_RESULTS=50

# ─── 通用 ───
LOG_LEVEL=INFO
